@startuml componentes_portal
!include <C4/C4_Component>
!include estilo.iuml
LAYOUT_TOP_DOWN()
title Componentes del portal web, UD-09 (C4 nivel 3): ASP.NET Core Razor Pages

Person(usuario, "Usuario", "Coordinador, evaluador o consulta")
Container_Boundary(portal, "UD-09 Portal web · ASP.NET Core 10 en Kestrel") {
  Component(auth, "Autenticación por cookie", "Middleware de ASP.NET Core", "Sin sesión lleva a /login; la cookie solo lleva identidad e id de sesión", $tags="construido")
  Component(paginas, "Páginas", "Razor Pages: vista .cshtml + PageModel", "Desastres, Tablero, Evaluaciones, Mapa, Reconstrucción, Usuarios, Login. El PageModel expone los datos que la vista enlaza y atiende los formularios (OnGet/OnPost)", $tags="construido")
  Component(antif, "Antifalsificación", "ASP.NET Core Antiforgery", "Token en cada formulario; rechaza un POST sin él (CSRF)", $tags="construido")
  Component(proxy, "Endpoint /tablero", "Minimal API", "Reenvía la consulta del mapa al servicio de tablero con el token del usuario", $tags="construido")
  Component(almacen, "AlmacenSesiones", "IMemoryCache", "Token del núcleo por sesión; nunca llega al navegador", $tags="construido")
  Component(cn, "NucleoCliente", "HttpClient", "Sesión, usuarios, desastres, fase y caracterización", $tags="construido")
  Component(cs, "ServidorCliente", "HttpClient", "Evaluaciones, historial y fotos", $tags="construido")
  Component(cr, "ReconstruccionCliente", "Cliente gRPC generado de reconstruccion.proto", "Proyectos; token en el metadato authorization", $tags="construido")
  Component(ct, "TableroCliente", "HttpClient", "Tablero de un desastre", $tags="construido")
}
Container(nucleo, "UD-02 Núcleo", "Jakarta EE", $tags="construido")
Container(servidor, "UD-03 Campo y mapas", "ASP.NET Core", $tags="construido")
Container(rec, "UD-06 Reconstrucción", "Spring Boot, gRPC", $tags="construido")
Container(tablero, "UD-10 Servicio de tablero", "Spring Boot, servlet asíncrono", $tags="construido")

Rel(usuario, auth, "Páginas y formularios", "HTTP")
Rel(usuario, proxy, "Datos del mapa (JavaScript)", "HTTP/JSON")
Rel(auth, paginas, "Solicitud con sesión")
Rel(paginas, antif, "Valida el POST")
Rel(paginas, almacen, "Token del usuario")
Rel(proxy, almacen, "Token del usuario")
Rel(paginas, cn, "Usa")
Rel(paginas, cs, "Usa")
Rel(paginas, cr, "Usa")
Rel(proxy, ct, "Usa")
Rel(cn, nucleo, "REST/JSON")
Rel(cs, servidor, "REST/JSON")
Rel(cr, rec, "gRPC")
Rel(ct, tablero, "REST/JSON (Bearer)")
SHOW_LEGEND()
@enduml
