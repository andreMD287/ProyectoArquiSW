@startuml srs_contexto
!include <C4/C4_Context>
!include estilo.iuml
' Diagrama de contexto del SRS: la plataforma es una caja negra.
' Nombres, mecanismos y estado tomados del SAD §3.1 y §3.2.
AddElementTag("ext_disenado", $bgColor="#f3f4f6", $fontColor="#374151", $borderColor="#6b7280", $borderStyle=DashedLine(), $legendText="Sistema externo con integración diseñada")
AddElementTag("ext_construido", $bgColor="#d1d5db", $fontColor="#111827", $borderColor="#374151", $legendText="Sistema externo con integración construida")
AddElementTag("persona_disenada", $bgColor="#f3f4f6", $fontColor="#374151", $borderColor="#6b7280", $borderStyle=DashedLine(), $legendText="Actor de una función diseñada")
AddRelTag("disenada", $lineStyle=DashedLine(), $textColor="#4b5563", $lineColor="#6b7280", $legendText="Integración diseñada, sin adaptador")
LAYOUT_TOP_DOWN()
HIDE_STEREOTYPE()
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #9CA3AF
skinparam legendFontColor #111827
skinparam legendFontSize 13
title Diagrama de contexto · Plataforma para la Gestión de Desastres y Reconstrucción

Boundary(usuarios, "Usuarios de los organismos") {
  Person(coo, "Coordinador", "Rol COORDINADOR: registra el desastre, gestiona proyectos y usuarios")
  Person(eva, "Evaluador de campo", "Rol EVALUADOR: evalúa daños y caracteriza, también sin conexión")
  Person(cns, "Consulta", "Rol CONSULTA: solo lectura, incluida la auditoría")
}
Person(ciu, "Ciudadano", "Consulta pública, sin sesión", $tags="persona_disenada")
System_Ext(cli, "Sistemas que no usan REST", "Inician sesión con una cuenta de la plataforma", $tags="ext_construido")

System(p, "Plataforma para la Gestión de Desastres y Reconstrucción", "Registra y caracteriza desastres, evalúa daños, gestiona la reconstrucción física y avisa a los interesados", $tags="construido")

Boundary(alerta, "SE-01 Alerta temprana") {
  System_Ext(se01a, "SE-01a Sistemas de alerta temprana", "", $tags="ext_disenado")
  System_Ext(se01b, "SE-01b Estaciones meteorológicas", "", $tags="ext_disenado")
  System_Ext(se01c, "SE-01c Sensores sísmicos", "", $tags="ext_disenado")
}
Boundary(geo, "Información y comunicación") {
  System_Ext(se02, "SE-02 Sistemas de información geográfica (GIS)", "", $tags="ext_disenado")
  System_Ext(se08, "SE-08 Comunicación y notificación", "", $tags="ext_construido")
}
Boundary(atencion, "Atención, recursos y personas") {
  System_Ext(se03, "SE-03 Hospitalarios", "", $tags="ext_disenado")
  System_Ext(se04, "SE-04 Gestión de recursos", "Dueño de recursos y donaciones", $tags="ext_disenado")
  System_Ext(se05, "SE-05 Identificación y atención de personas", "Dueño de los datos de personas", $tags="ext_disenado")
}
Boundary(admin, "Gestión administrativa y obras") {
  System_Ext(se06, "SE-06 Administrativos y financieros", "", $tags="ext_disenado")
  System_Ext(se07, "SE-07 Proyectos de infraestructura", "", $tags="ext_disenado")
}

Rel(coo, p, "Usa", "portal web")
Rel(eva, p, "Usa", "app de campo y portal web")
Rel(cns, p, "Consulta", "portal web")
Rel(ciu, p, "Consulta lo publicable", "diseñada", $tags="disenada")
Rel(cli, p, "Inicia sesión", "SOAP o EJB remoto")

Rel_R(se01a, p, "Alertas", "cola o webhook", $tags="disenada")
Rel_R(se01b, p, "Datos meteorológicos", "cola o webhook", $tags="disenada")
Rel_R(se01c, p, "Detecciones sísmicas", "cola o webhook", $tags="disenada")
Rel_D(p, se02, "Pide geometrías de zonas afectadas", "REST inmediato", $tags="disenada")
Rel_D(p, se08, "Avisos y correo", "cola por suscriptor y SMTP")
Rel_D(p, se03, "Avisa el desastre; recibe capacidad", "cola diferida; consulta cada 60 s", $tags="disenada")
Rel_D(p, se04, "Consulta disponibilidad", "consulta cada 5 min", $tags="disenada")
Rel_D(p, se05, "Cruza solo identificadores", "REST y cola", $tags="disenada")
Rel_D(p, se06, "Compromiso presupuestal y respuesta", "cola diferida", $tags="disenada")
Rel_D(p, se07, "Proyectos, avances y estado", "cola diferida", $tags="disenada")

Lay_R(coo, eva)
Lay_R(eva, cns)
Lay_R(usuarios, ciu)
Lay_R(ciu, cli)
Lay_D(se01a, se01b)
Lay_D(se01b, se01c)
Lay_L(p, alerta)
Lay_R(se02, se08)
Lay_R(se03, se04)
Lay_R(se04, se05)
Lay_R(se06, se07)
Lay_R(geo, atencion)
Lay_R(atencion, admin)

legend right
<b>Leyenda</b>
|<#08427B>      | Persona con un rol en la plataforma |
|<#1D4ED8>      | La plataforma, construida (caja negra) |
|<#D1D5DB>      | Sistema externo con integración construida |
|<#F3F4F6>      | Sistema externo o actor con integración diseñada (borde punteado) |
Línea continua: uso o integración construida.
Línea punteada: integración diseñada, sin adaptador.
El recuadro punteado agrupa sistemas externos afines.
endlegend
@enduml
