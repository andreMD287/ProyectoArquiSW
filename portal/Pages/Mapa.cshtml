@page "/mapa"
@model Portal.Pages.MapaModel
@{
    ViewData["Titulo"] = "Mapa de desastres";
}
@section Cabeza {
  <link rel="stylesheet" href="/lib/leaflet/leaflet.css">
}
<main class="contenido">
  <h1>Mapa de desastres</h1>
  <p class="tenue">Área afectada de cada desastre caracterizado, con el color de su fase. Abre un desastre
    para ver sus evaluaciones de daño y sus proyectos de reconstrucción.</p>
  <div class="leyenda">
    <span class="fase fase-registro">Registro</span><span class="fase fase-caracterizacion">Caracterización</span>
    <span class="fase fase-reconstruccion">Reconstrucción</span><span class="fase fase-cierre">Cierre</span>
  </div>
  <div id="mapa-general" class="mapa alto"></div>
  <p id="sin-ubicacion" class="tenue"></p>
</main>
@section Scripts {
  <script>window.DESASTRES = @Html.Raw(Model.DesastresJson);</script>
  <script src="/lib/leaflet/leaflet.js"></script>
  <script src="/js/mapa-general.js"></script>
}
